#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Paolo Gentili
"""Tiny GTK 4 preset picker for aida-x-live: choose a preset, it's recalled,
and the guitar-side settings for it (pickup, volume, tone, tip) are shown.

Guitar settings live next to each preset in <name>.guitar.json:
  {"pickup": "bridge", "volume": "10", "tone": "10", "notes": "..."}
"""
import json
import os
import socket

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk  # noqa: E402

SOCK = os.path.expanduser("~/.local/state/aida-x/carla.sock")
PRESET_DIR = os.path.expanduser("~/.local/state/aida-x/presets")
PLACEHOLDER = "— choose a preset —"


def ctl(cmd: str) -> str:
    """Send one command to the aida-x-carla daemon and return its reply."""
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(5)
        s.connect(SOCK)
        s.sendall((cmd + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n.\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    return buf.decode().removesuffix("\n.\n")


class Picker(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="AIDA-X Presets")
        # Resizable on purpose: a non-resizable window can't grow when the
        # Guitar panel appears (GTK warns "needs at least N" and clips it).
        self.set_default_size(340, -1)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{side}")(16)

        row = Gtk.Box(spacing=8)
        self.model = Gtk.StringList()
        self.dropdown = Gtk.DropDown(model=self.model)
        self.dropdown.set_hexpand(True)
        self.handler = self.dropdown.connect("notify::selected", self.on_selected)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Reload preset list")
        refresh.connect("clicked", lambda *_: self.reload())
        row.append(self.dropdown)
        row.append(refresh)

        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("dim-label")

        # Guitar-side settings for the selected preset
        self.guitar = Gtk.Grid(column_spacing=12, row_spacing=4)
        self.fields = {}
        for r, key in enumerate(("pickup", "volume", "tone")):
            name = Gtk.Label(label=key.capitalize(), xalign=0)
            name.add_css_class("dim-label")
            value = Gtk.Label(xalign=0, selectable=True)
            self.guitar.attach(name, 0, r, 1, 1)
            self.guitar.attach(value, 1, r, 1, 1)
            self.fields[key] = value
        self.notes = Gtk.Label(xalign=0, wrap=True, max_width_chars=40, selectable=True)
        self.guitar.attach(self.notes, 0, 3, 2, 1)
        frame = Gtk.Frame(label="Guitar")
        self.guitar.set_margin_top(6)
        self.guitar.set_margin_bottom(8)
        self.guitar.set_margin_start(10)
        self.guitar.set_margin_end(10)
        frame.set_child(self.guitar)
        self.frame = frame
        frame.set_visible(False)

        box.append(row)
        box.append(frame)
        box.append(self.status)
        self.set_child(box)
        self.reload()

    def reload(self):
        try:
            names = [n for n in ctl("presets").splitlines() if n and n != "(none)"]
            msg = f"{len(names)} presets"
        except OSError:
            names, msg = [], "aida-x-live isn't running"
        with self.dropdown.handler_block(self.handler):
            self.model.splice(0, self.model.get_n_items(), [PLACEHOLDER, *names])
            self.dropdown.set_selected(0)
        self.status.set_text(msg)

    def on_selected(self, dropdown, _pspec):
        i = dropdown.get_selected()
        if i in (0, Gtk.INVALID_LIST_POSITION):
            return
        name = self.model.get_string(i)
        self.show_guitar(name)
        self.status.set_text(f"loading {name}…")
        # let the label repaint before the (short) blocking call
        GLib.idle_add(self.recall, name)

    def show_guitar(self, name):
        try:
            with open(os.path.join(PRESET_DIR, name + ".guitar.json")) as f:
                g = json.load(f)
        except (OSError, ValueError):
            self.frame.set_visible(False)
            return
        self.fields["pickup"].set_markup(f"<b>{GLib.markup_escape_text(str(g.get('pickup', '?')).upper())}</b>")
        self.fields["volume"].set_text(str(g.get("volume", "—")))
        self.fields["tone"].set_text(str(g.get("tone", "—")))
        self.notes.set_text(g.get("notes", ""))
        self.notes.set_visible(bool(g.get("notes")))
        self.frame.set_visible(True)

    def recall(self, name):
        try:
            reply = ctl(f"recall {name}")
            self.status.set_text(f"▶ {name}" if reply == "ok" else reply)
        except OSError as e:
            self.status.set_text(f"error: {e}")
        return GLib.SOURCE_REMOVE


app = Gtk.Application(application_id="local.aidax.presets")
app.connect("activate", lambda a: Picker(a).present())
app.run(None)
