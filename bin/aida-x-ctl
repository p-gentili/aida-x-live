import socket, sys, os
s = socket.socket(socket.AF_UNIX); s.connect(os.path.expanduser("~/.local/state/aida-x/carla.sock"))
s.sendall((" ".join(sys.argv[1:]) + "\n").encode()); buf = b""
while not buf.endswith(b"\n.\n"):
    c = s.recv(65536)
    if not c: break
    buf += c
print(buf.decode().removesuffix("\n.\n"))
